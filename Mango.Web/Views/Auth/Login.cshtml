@model LoginRequestDto

<form asp-action="Login">
    <br />
    <div class="container border p-3">
        <h1 class="text-white text-center">Login</h1>

        <hr />
        <div class="row">
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">User Name</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Password</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="col-5 offset-2">
                <a asp-action="Register" class="btn-primary btn form-control">Register</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Login" class="btn btn-success form-control" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
