@model ProductDto

<form asp-action="ProductDelete">
    <input asp-for="ProductId" hidden />
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-secondary bg-gradient ml-0 py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="text-white">Delete Product</h1>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-12 pb-3">
                    <label class="form-label">Product Name</label>
                    <input asp-for="Name" disabled class="form-control" />
                </div>
                <div class="col-md-6 pb-3">
                    <label class="form-label">Category Name</label>
                    <input asp-for="CategoryName" disabled class="form-control" />
                </div>
                <div class="col-md-6 pb-3">
                    <label class="form-label">Price</label>
                    <input asp-for="Price" disabled class="form-control" />
                </div>
                <div class="col-md-12 pb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" disabled class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-12 pb-3">
                    <label class="form-label">Image Url</label>
                    <input asp-for="ImageUrl" disabled class="form-control" />
                </div>
                <div class="col-md-6">
                    <a asp-controller="Product" asp-action="ProductIndex" class="btn btn-secondary form-control">
                        Back to List
                    </a>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-danger form-control">Delete</button>
                </div>
            </div>
        </div>
    </div>
</form>